{
  "schemaVersion": "stage-2-semantic-appearance-baselines-v2",
  "version": "stage-2-semantic-appearance-baselines-v2",
  "artifactRole": "development-only-quality-baseline-set",
  "productionUse": "prohibited",
  "policy": {
    "geometry": "retain the frozen object category v1 geometry hard metrics",
    "exactPositionTexture": "diagnostic for accepted procedural texture alternatives",
    "semanticRoles": "hard, bounded, and falsified by destructive appearance controls",
    "replacementFailuresMayRewriteV1": false
  },
  "objects": {
    "bamboo-shoot": {
      "version": "bamboo-shoot-semantic-category-baseline-v2",
      "objectId": "bamboo-shoot",
      "evidencePolicy": "bounded-semantic-material-roles-v2",
      "semanticRoles": {
        "core": [45, 34, 24],
        "sheath": [59, 125, 17]
      },
      "maximumRoleDistance": 20,
      "hard": [
        {
          "path": "semanticPattern.roles.core.replacementCoverage",
          "operator": ">=",
          "threshold": 0.75,
          "domain": "appearance",
          "source": "candidate-informed-positive-with-destructive-separation"
        },
        {
          "path": "semanticPattern.roles.core.replacementCoverage",
          "operator": "<=",
          "threshold": 1,
          "domain": "appearance",
          "source": "bounded-role-coverage"
        },
        {
          "path": "semanticPattern.roles.sheath.replacementCoverage",
          "operator": ">=",
          "threshold": 0.003,
          "domain": "appearance",
          "source": "reject-deleted-sheath-role"
        },
        {
          "path": "semanticPattern.roles.sheath.replacementCoverage",
          "operator": "<=",
          "threshold": 0.05,
          "domain": "appearance",
          "source": "bounded-role-coverage"
        },
        {
          "path": "semanticPattern.roles.core.meanReplacementRoleDistance",
          "operator": "<=",
          "threshold": 16,
          "domain": "appearance",
          "source": "declared-role-palette"
        },
        {
          "path": "semanticPattern.roles.sheath.meanReplacementRoleDistance",
          "operator": "<=",
          "threshold": 4,
          "domain": "appearance",
          "source": "declared-role-palette"
        },
        {
          "path": "appearance.roughnessAbsoluteError",
          "operator": "<=",
          "threshold": 0.1,
          "domain": "appearance",
          "source": "unchanged-stage-2-category-v1"
        },
        {
          "path": "appearance.metalnessAbsoluteError",
          "operator": "<=",
          "threshold": 0.05,
          "domain": "appearance",
          "source": "unchanged-stage-2-category-v1"
        }
      ],
      "diagnostic": [
        "appearance.meanDeltaE00",
        "appearance.p90DeltaE00",
        "appearance.meanMaskedSsim",
        "appearance.worstViewSsim",
        "appearance.paletteCentroidDeltaE00",
        "appearance.paletteCoverageL1"
      ],
      "requiredDestructiveControls": [
        "delete-sheath-role",
        "wrong-role-palette",
        "flat-single-role"
      ],
      "frozen": true
    },
    "mushroom": {
      "version": "mushroom-semantic-category-baseline-v2",
      "objectId": "mushroom",
      "evidencePolicy": "bounded-semantic-material-roles-v2",
      "semanticRoles": {
        "cap": [78, 23, 16],
        "stem": [98, 91, 75]
      },
      "maximumRoleDistance": 12,
      "hard": [
        {"path":"semanticPattern.roles.cap.replacementCoverage","operator":">=","threshold":0.3,"domain":"appearance","source":"reject-deleted-cap-role"},
        {"path":"semanticPattern.roles.cap.replacementCoverage","operator":"<=","threshold":0.8,"domain":"appearance","source":"bounded-role-coverage"},
        {"path":"semanticPattern.roles.stem.replacementCoverage","operator":">=","threshold":0.15,"domain":"appearance","source":"reject-deleted-stem-role"},
        {"path":"semanticPattern.roles.stem.replacementCoverage","operator":"<=","threshold":0.7,"domain":"appearance","source":"bounded-role-coverage"},
        {"path":"semanticPattern.roles.cap.meanReplacementRoleDistance","operator":"<=","threshold":4,"domain":"appearance","source":"reference-albedo-role"},
        {"path":"semanticPattern.roles.stem.meanReplacementRoleDistance","operator":"<=","threshold":4,"domain":"appearance","source":"reference-albedo-role"},
        {"path":"appearance.roughnessAbsoluteError","operator":"<=","threshold":0.1,"domain":"appearance","source":"unchanged-stage-2-category-v1"},
        {"path":"appearance.metalnessAbsoluteError","operator":"<=","threshold":0.05,"domain":"appearance","source":"unchanged-stage-2-category-v1"}
      ],
      "diagnostic": [
        "appearance.meanDeltaE00",
        "appearance.p90DeltaE00",
        "appearance.meanMaskedSsim",
        "appearance.worstViewSsim",
        "appearance.paletteCentroidDeltaE00",
        "appearance.paletteCoverageL1"
      ],
      "requiredDestructiveControls": [
        "delete-cap-role",
        "delete-stem-role",
        "wrong-role-palette"
      ],
      "frozen": true
    }
  }
