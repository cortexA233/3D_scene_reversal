{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh-to-code/response.structure-proposal.schema.json",
  "title": "Structure proposal response",
  "description": "Propose mutually dissimilar structure candidates as Contract Operator compositions. A decider may influence where the search goes; it may never influence what passes, so no field here can alter a threshold or a tier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "parts"],
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["groupId", "operatorId"],
              "properties": {
                "groupId": { "type": "string", "minLength": 1 },
                "operatorId": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "rationale": { "type": ["string", "null"] }
  }
}
