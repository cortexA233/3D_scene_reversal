# Frozen evidence hashes source and generated files byte-for-byte, so every
# platform must materialize the same line endings in the working tree.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.glb binary
*.gltf binary
*.bin binary
*.ktx2 binary
*.hdr binary
*.exr binary
*.wasm binary
*.drc binary
